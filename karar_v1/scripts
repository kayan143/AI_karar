$ErrorActionPreference = 'Stop'

$projectDirectory = Split-Path -Parent $PSScriptRoot
$environmentPath = Join-Path $projectDirectory '.env'
Set-Location $projectDirectory

function Read-EnvironmentValue([string]$name, [string]$defaultValue) {
  if (-not (Test-Path $environmentPath)) {
    return $defaultValue
  }
  $line = Get-Content $environmentPath |
    Where-Object { $_ -match ('^\s*' + [regex]::Escape($name) + '=') } |
    Select-Object -First 1
  if (-not $line) {
    return $defaultValue
  }
  $value = ($line -replace ('^\s*' + [regex]::Escape($name) + '='), '').Trim()
  if ($value.Length -ge 2 -and $value.StartsWith('"') -and $value.EndsWith('"')) {
    return $value.Substring(1, $value.Length - 2)
  }
  if ($value.Length -ge 2 -and $value.StartsWith("'") -and $value.EndsWith("'")) {
    return $value.Substring(1, $value.Length - 2)
  }
  return $value
}

$ollamaBaseUrl = (Read-EnvironmentValue 'OLLAMA_BASE_URL' 'http://localhost:11434').TrimEnd('/')
$ollamaModel = Read-EnvironmentValue 'OLLAMA_MODEL' 'llama3.2:3b'
$translationModel = Read-EnvironmentValue 'OLLAMA_TRANSLATION_MODEL' 'qwen2.5:3b'
$embeddingModel = Read-EnvironmentValue 'OLLAMA_EMBEDDING_MODEL' 'nomic-embed-text'
$ollamaTagsUrl = "$ollamaBaseUrl/api/tags"

function Get-OllamaModels {
  try {
    return Invoke-RestMethod -Uri $ollamaTagsUrl -TimeoutSec 3
  } catch {
    return $null
  }
}

$ollamaStatus = Get-OllamaModels
if (-not $ollamaStatus -and $ollamaBaseUrl -match '^https?://(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?$') {
  $ollama = Get-Command ollama.exe -ErrorAction SilentlyContinue
  if (-not $ollama) {
    throw 'Ollama is not running and ollama.exe was not found. Install Ollama, then launch Karar again.'
  }
  Write-Host 'Starting the local Ollama service...'
  Start-Process -FilePath $ollama.Source -ArgumentList 'serve' -WindowStyle Hidden | Out-Null
  for ($attempt = 0; $attempt -lt 30 -and -not $ollamaStatus; $attempt++) {
    Start-Sleep -Seconds 1
    $ollamaStatus = Get-OllamaModels
  }
}
if (-not $ollamaStatus) {
  throw 'Could not reach the configured Ollama service. Start Ollama or check OLLAMA_BASE_URL in .env.'
}

$installedModels = @($ollamaStatus.models | ForEach-Object { $_.name })
function Test-OllamaModelInstalled([string]$modelName) {
  return ($installedModels -contains $modelName) -or ($installedModels -contains ($modelName + ':latest'))
}
if (-not (Test-OllamaModelInstalled $ollamaModel)) {
  throw "Ollama is running, but '$ollamaModel' is not installed. Run: ollama pull $ollamaModel"
}
Write-Host "Ollama ready: $ollamaModel"
if (Test-OllamaModelInstalled $embeddingModel) {
  Write-Host "Document embedding model ready: $embeddingModel"
} else {
  Write-Warning "Document search requires the embedding model '$embeddingModel'. Install it with: ollama pull $embeddingModel"
}
if (Test-OllamaModelInstalled $translationModel) {
  Write-Host "Arabic translation model ready: $translationModel"
} else {
  Write-Warning "Arabic replies require the translation model '$translationModel'. Install it with: ollama pull $translationModel"
}

$processes = @(Get-CimInstance Win32_Process)
$processById = @{}
foreach ($process in $processes) {
  $processById[[int]$process.ProcessId] = $process
}

$projectPattern = [regex]::Escape($projectDirectory)
$kararProcessIds = [System.Collections.Generic.HashSet[int]]::new()
foreach ($process in $processes) {
  $commandLine = [string]$process.CommandLine
  $isKararEntryPoint = $commandLine -match $projectPattern -and
    $commandLine -match '(?i)(concurrently|vite\.js|server[\\/]dev\.js|server[\\/]index\.js)'
  if ($isKararEntryPoint) {
    [void]$kararProcessIds.Add([int]$process.ProcessId)
  }
}

$changed = $true
while ($changed) {
  $changed = $false
  foreach ($process in $processes) {
    $processId = [int]$process.ProcessId
    $parentId = [int]$process.ParentProcessId
    if (-not $kararProcessIds.Contains($processId) -and $kararProcessIds.Contains($parentId)) {
      [void]$kararProcessIds.Add($processId)
      $changed = $true
    }
  }
}

$listeners = @(Get-NetTCPConnection -State Listen -LocalPort 5000, 5001 -ErrorAction SilentlyContinue)
foreach ($listener in $listeners) {
  if (-not $kararProcessIds.Contains([int]$listener.OwningProcess)) {
    throw "Port $($listener.LocalPort) is used by another application (PID $($listener.OwningProcess)). It was left running."
  }
}

if ($kararProcessIds.Count -gt 0) {
  Write-Host 'Restarting Karar processes identified in this project...'
  $toStop = foreach ($processId in $kararProcessIds) {
    if ($processById.ContainsKey($processId)) {
      $depth = 0
      $parentId = [int]$processById[$processId].ParentProcessId
      while ($parentId -and $kararProcessIds.Contains($parentId) -and $depth -lt 64) {
        $depth++
        $parentId = [int]$processById[$parentId].ParentProcessId
      }
      [pscustomobject]@{ Id = $processId; Depth = $depth }
    }
  }
  foreach ($process in $toStop | Sort-Object Depth) {
    Stop-Process -Id $process.Id -Force -ErrorAction SilentlyContinue
  }
  for ($attempt = 0; $attempt -lt 20; $attempt++) {
    $listeners = @(Get-NetTCPConnection -State Listen -LocalPort 5000, 5001 -ErrorAction SilentlyContinue)
    if ($listeners.Count -eq 0) {
      break
    }
    Start-Sleep -Milliseconds 250
  }
  if ($listeners.Count -gt 0) {
    throw 'Karar did not release its ports. No unrelated processes were stopped.'
  }
}

& powershell.exe -NoProfile -ExecutionPolicy Bypass -File (Join-Path $PSScriptRoot 'ensure-local-tls.ps1')
if ($LASTEXITCODE -ne 0) {
  throw 'Karar local HTTPS certificate setup failed.'
}

Write-Host ''
Write-Host 'Starting Karar. Ollama will remain running when you close Karar.'
& npm.cmd run dev
exit $LASTEXITCODE
